{
  "name": "chuckles-and-chai",
  "version": "1.0.0",
  "private": true,
  "description": "Website for Chuckles & Chai — Awaken With Aroma.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"tests/**/*.test.ts\"",
    "placeholders": "node scripts/make-placeholders.mjs",
    "photos": "node scripts/fetch-photos.mjs",
    "check": "npm run typecheck && npm run lint && npm run test",
    "prebuild": "node scripts/generate-meta.mjs",
    "predev": "node scripts/generate-meta.mjs",
    "meta": "node scripts/generate-meta.mjs",
    "icons": "node scripts/make-icons.mjs",
    "assets": "npm run placeholders && npm run icons"
  },
  "dependencies": {
    "next": "15.5.4",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "eslint": "^9.17.0",
    "eslint-config-next": "15.5.4",
    "playwright-core": "^1.62.1",
    "sharp": "^0.34.2",
    "typescript": "^5.7.2"
  }
}
